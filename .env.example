# Copy this file to .env and fill in whichever provider you actually use.
# .env is gitignored — your key never gets committed. Without either key,
# the app works exactly the same; the AI copilot panel just shows setup
# instructions instead.

# Which provider ai-service.ts uses. Defaults to "gemini" if unset.
# AI_PROVIDER=gemini

# --- Gemini (default provider) ---
GEMINI_API_KEY=

# --- Anthropic (set AI_PROVIDER=anthropic above to use this instead) ---
# ANTHROPIC_API_KEY=
